{
  "name": "@airbnb-extended/vitest-config",
  "version": "3.3.0",
  "private": true,
  "description": "Vitest config",
  "homepage": "https://eslint-airbnb-extended.nishargshah.dev",
  "bugs": {
    "url": "https://github.com/eslint-config/airbnb-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eslint-config/airbnb-extended.git",
    "directory": "configs/vitest-config"
  },
  "license": "MIT",
  "author": "Nisharg Shah <nishargshah3101@gmail.com>",
  "type": "module",
  "exports": {
    "./base": "./src/vitest-base.config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier . --check --log-level silent --ignore-path ../../.gitignore",
    "format:fix": "prettier . --write --log-level silent --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "script:lint": "bash -e ../../scripts/lint.sh --filter=@airbnb-extended/vitest-config --no-typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@airbnb-extended/typescript-config": "workspace:*"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  }
}

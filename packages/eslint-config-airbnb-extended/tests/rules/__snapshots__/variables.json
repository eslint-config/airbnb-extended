{
  "variablesRules": {
    "name": "airbnb/config/variables",
    "files": [
      "**/*.js",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.jsx",
      "**/*.ts",
      "**/*.cts",
      "**/*.mts",
      "**/*.tsx",
      "**/*.d.ts"

{
  "legacyNodeRules": {
    "name": "airbnb/config/node/legacy",
    "files": [
      "**/*.js",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.jsx",
      "**/*.ts",
      "**/*.cts",
      "**/*.mts",
      "**/*.tsx",
      "**/*.d.ts"
    ],
    "rules": {
      "callback-return": "off",
      "global-require": "error",
      "handle-callback-err": "off",
      "no-buffer-constructor": "error",
      "no-mixed-requires": [
        "off",
        false
      ],
      "no-new-require": "error",
      "no-path-concat": "error",
      "no-process-env": "off",
      "no-process-exit": "off",
      "no-restricted-modules": "off",
      "no-sync": "off"
    }
  }
}
